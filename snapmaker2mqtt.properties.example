# Snapmaker2MQTT configuration
# Every key can be overridden by an environment variable: S2M_ + key in upper case, dots -> underscores
# e.g. mqtt.host -> S2M_MQTT_HOST, printer.host -> S2M_PRINTER_HOST

# ---------------------------------------------------------------- MQTT broker
mqtt.host=localhost
# 1883 (plain) or 8883 (TLS)
mqtt.port=1883
mqtt.tls=false
mqtt.username=
mqtt.password=
mqtt.client_id=snapmaker2mqtt
mqtt.topic_prefix=snapmaker
# QoS for status messages (events and availability always use at least QoS 1)
mqtt.qos=0
mqtt.keepalive=30

# ---------------------------------------------------------------- printer(s)
# Single printer:
printer.id=u1
printer.host=192.168.1.50
printer.port=7125
# Only needed if [authorization] is enabled in moonraker.conf
printer.api_key=

# Several printers (instead of the block above):
#printers=u1a,u1b
#printer.u1a.host=192.168.1.50
#printer.u1b.host=192.168.1.51
#printer.u1b.port=7125
#printer.u1b.api_key=

# ---------------------------------------------------------------- publishing
# Minimum time between two status messages while values are changing
publish.interval_ms=1000
# Republish the status at least this often
publish.heartbeat_seconds=60
# Single values under <prefix>/<id>/state/...
publish.flat_topics=true
# Raw Klipper objects under <prefix>/<id>/raw/<object>
publish.raw=false
# Klipper console output under <prefix>/<id>/console
publish.console=false

# ---------------------------------------------------------------- events
# PROGRESS event every n percent (0 = off)
events.progress_step=10
events.layer=true
events.machine_action=true

# ---------------------------------------------------------------- commands
# Accept commands on <prefix>/<id>/command/<name>
commands.enabled=true
# Allow arbitrary G-code via <prefix>/<id>/command/gcode
commands.gcode=true

# ---------------------------------------------------------------- logging
# SEVERE, WARNING, INFO, FINE
log.level=INFO
