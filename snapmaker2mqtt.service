[Unit]
Description=snapmaker2mqtt bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snapmaker2mqtt
WorkingDirectory=/opt/snapmaker2mqtt
# snapmaker2mqtt.jar and the lib folder from target/ are copied to /opt/snapmaker2mqtt
ExecStart=/usr/bin/java -jar /opt/snapmaker2mqtt/snapmaker2mqtt.jar --config /opt/snapmaker2mqtt/config.yml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
